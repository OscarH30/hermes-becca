# ---------------------------------------------------------------------
# Becca environment
#
# You do NOT need to fill this in before talking to her.
#
# Onboarding connects her tools for you and wires them to this profile.
# This file only matters if you choose direct API keys instead of Composio or
# your platform's own connectors. She will tell you which values she needs, if
# any. Type keys here yourself. Never paste a key into the chat.
#
# On a platform without a .env file (for example Grok Bot), use the platform's
# secrets or connector settings instead.
#
# Leaving every line blank is a perfectly normal, working setup.
# ---------------------------------------------------------------------

# Composio (recommended path: covers Apollo, Instantly, your CRM, Gmail, calendar)
COMPOSIO_API_KEY=

# Apollo: only if not using Composio. Needs a plan with API access.
APOLLO_API_KEY=

# treg.to: pay-per-call research tools (verify emails, enrich companies, local
# business data). Only if your platform needs a key; prefer the platform's
# secure connector. Usual setup: tell your agent
#   set up treg - https://treg.to/llms.txt
# and approve the connection in treg.to. Leave blank otherwise.
TREG_API_KEY=

# Instantly: recommended for sending. Becca loads each approved campaign into
# Instantly, which sends it in your name from your warmed lookalike domains.
# Only needed if you are NOT connecting Instantly through Composio.
INSTANTLY_API_KEY=

# AgentMail: an alternative sending inbox.
AGENTMAIL_API_KEY=

# CRM: optional, and any one works. Attio and HubSpot below are only examples.
# Only needed if you are not connecting your CRM through Composio or a
# connector. With no CRM, Becca uses a CSV or Google Sheet (see BECCA_CRM_FALLBACK).
# Attio:
ATTIO_API_KEY=

# HubSpot: only if HubSpot is your CRM and you are not using Composio. Private-app token.
HUBSPOT_ACCESS_TOKEN=

# GoHighLevel: only if it is your CRM and you are not using Composio. Both values required together.
GHL_API_KEY=
GHL_LOCATION_ID=

# Your scheduling link (Cal.com, Calendly, HubSpot Meetings).
# Set this and Becca never needs calendar API access at all.
BECCA_BOOKING_LINK=

# Optional pre-fills. Onboarding confirms each one with you, and the values in
# brain/config.md always win. Leave blank to be asked.
# Where Becca emails your daily campaign for approval.
BECCA_APPROVAL_EMAIL=
# Contacts in each daily campaign.
BECCA_CAMPAIGN_SIZE=50
# Your CRM, if any (for example attio, hubspot, gohighlevel). Blank means none.
BECCA_CRM=
# Where Interested replies go when there is no CRM: csv or google_sheet.
BECCA_CRM_FALLBACK=csv
