# ─────────────────────────────────────────────────────────────────────
# Becca — environment
#
# Everything here is OPTIONAL. If you connect your tools through Composio
# (recommended), you do not need to fill in any API key below.
#
#   composio link apollo
#   composio link gmail          # or: composio link outlook
#   composio link hubspot        # or: composio link gohighlevel
#   composio link googlecalendar
#
# Fill in only the lines for tools you are NOT connecting via Composio.
# ─────────────────────────────────────────────────────────────────────

# Composio (recommended path — covers Apollo, Gmail, CRM, calendar)
COMPOSIO_API_KEY=

# Apollo — only if not using Composio. Needs a plan with API access.
APOLLO_API_KEY=

# AgentMail — fastest way to give Becca her own sending inbox.
AGENTMAIL_API_KEY=

# HubSpot — only if not using Composio. Private-app token.
HUBSPOT_ACCESS_TOKEN=

# GoHighLevel — only if not using Composio. Both values required together.
GHL_API_KEY=
GHL_LOCATION_ID=

# Your scheduling link (Calendly, Cal.com, HubSpot Meetings).
# Set this and Becca never needs calendar API access at all.
BECCA_BOOKING_LINK=
