# ─────────────────────────────────────────────────────────────────────
# Becca — environment
#
# You do NOT need to fill this in before talking to her.
#
# Onboarding connects her tools for you and wires them to this profile.
# This file only matters if you choose direct API keys instead of Composio.
# She will tell you which values she needs, if any.
#
# Leaving every line blank is a perfectly normal, working setup.
# ─────────────────────────────────────────────────────────────────────

# Composio (recommended path — covers Apollo, Gmail, CRM, calendar)
COMPOSIO_API_KEY=

# Apollo — only if not using Composio. Needs a plan with API access.
APOLLO_API_KEY=

# AgentMail — fastest way to give Becca her own sending inbox.
AGENTMAIL_API_KEY=

# HubSpot — only if not using Composio. Private-app token.
HUBSPOT_ACCESS_TOKEN=

# GoHighLevel — only if not using Composio. Both values required together.
GHL_API_KEY=
GHL_LOCATION_ID=

# Your scheduling link (Calendly, Cal.com, HubSpot Meetings).
# Set this and Becca never needs calendar API access at all.
BECCA_BOOKING_LINK=
